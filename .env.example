# HuggingFace model id to load. Standard pretrained model, auto-downloaded by transformers on first run.
MODEL_ID=lightonai/LightOnOCR-2-1B
# Inference device: cpu or cuda
DEVICE=cpu
# Torch dtype: float32, float16, or bfloat16 (forced to float32 on cpu)
DTYPE=float32
# Maximum number of tokens to generate per OCR request
MAX_NEW_TOKENS=4096
# Port the HTTP service listens on
PORT=10006
# Bearer token required in the Authorization header for the /ocr endpoint
API_KEY=your-api-key-here
